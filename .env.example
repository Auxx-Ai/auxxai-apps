# Auxx SDK API endpoints
# Copy this file to .env and update the values

AUXX_API_URL=https://api.auxx.ai
AUXX_APP_URL=https://app.auxx.ai

# Headless CLI auth for the batch scripts (scripts/push-all.ts loads .env).
# Skips the keychain + OAuth entirely. Mint one in the developer portal.
AUXX_API_KEY=auxx_dev_...
